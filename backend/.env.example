# ===========================================
# Backend Environment Configuration
# ===========================================
# Copy this file to .env and configure

# ===========================================
# Server Configuration
# ===========================================
NODE_ENV=development
PORT=3000

# ===========================================
# Database Configuration
# ===========================================
DATABASE_URL=postgresql://textbook:change_me_in_production@localhost:5432/textbook_marketplace

# ===========================================
# JWT Configuration
# ===========================================
# IMPORTANT: Change this in production!
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# ===========================================
# Application URLs
# ===========================================
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000

# ===========================================
# Admin Account (created on first run)
# ===========================================
ADMIN_EMAIL=admin@sachgiare.vn
ADMIN_PASSWORD=Admin123!

# ===========================================
# Security
# ===========================================
# 32 character encryption key
ENCRYPTION_KEY=32_character_encryption_key_here

# ===========================================
# AWS S3 (Optional)
# ===========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=

# ===========================================
# VNPAY Sandbox Configuration
# ===========================================
# Register at https://sandbox.vnpayment.vn/devreg/ to get credentials
# These are SANDBOX/TEST credentials - DO NOT use production credentials here
VNPAY_VERSION=2.1.0
VNPAY_COMMAND=pay
VNPAY_CURR_CODE=VND
VNPAY_LOCALE=vn
VNPAY_ORDER_TYPE=other
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay/return
VNPAY_IPN_URL=http://localhost:3000/api/payments/vnpay/ipn
