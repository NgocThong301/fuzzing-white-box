// ============================================
// Textbook Marketplace Database Schema
// C2C Platform for Students
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BANNED
}

enum RoleType {
  ADMIN
  MODERATOR
  SELLER
  BUYER
  USER
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SOLD
  HIDDEN
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PREPARING
  SHIPPING
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PaymentMethod {
  COD
  MOCK_ONLINE
  VNPAY_SANDBOX
  BANKING
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum EscrowStatus {
  CREATED
  FUNDED
  HELD
  RELEASED
  REFUNDED
  DISPUTED
}

enum TransactionType {
  DEPOSIT
  ESCROW_HOLD
  ESCROW_RELEASE
  REFUND
  WITHDRAWAL
}

enum NotificationType {
  ORDER_CREATED
  ORDER_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_COMPLETED
  ORDER_CANCELLED
  ORDER_DISPUTED
  LISTING_APPROVED
  LISTING_REJECTED
  REVIEW_RECEIVED
  REVIEW_APPROVED
  PAYMENT_SUCCESS
  NEW_MESSAGE
  PAYMENT_RECEIVED
  ESCROW_FUNDED
  ESCROW_RELEASED
  ESCROW_REFUNDED
  COUPON_EXPIRED
  SYSTEM_ANNOUNCEMENT
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ReportType {
  FAKE_LISTING
  SCAM
  INAPPROPRIATE_CONTENT
  PRICE_GOUGEING
  OTHER
}

enum BookCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum ShippingOption {
  PICKUP          // Người mua đến lấy
  DELIVERY        // Giao hàng
  BOTH            // Cả hai option
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id              Int          @id @default(autoincrement())
  email           String       @unique
  passwordHash    String
  fullName        String
  phone           String?      @unique
  avatar          String?
  status          UserStatus   @default(ACTIVE)
  universityId    Int?

  // Security fields
  loginAttempts   Int          @default(0)
  lockUntil       DateTime?
  passwordChangedAt DateTime?

  // Reputation (calculated from reviews)
  reputationScore Float        @default(0)
  totalSales     Int          @default(0)
  responseRate   Float        @default(100)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  // Relations
  university      University?  @relation(fields: [universityId], references: [id])
  roles           UserRole[]
  wallet          Wallet?
  listings        Listing[]     @relation("SellerListings")
  orders          Order[]      @relation("BuyerOrders")
  sellerOrders   Order[]      @relation("SellerOrders")
  cartItems      CartItem[]
  reviews         Review[]     @relation("ReviewAuthor")
  receivedReviews Review[]     @relation("ReviewTarget")
  favorites       Favorite[]
  notifications   Notification[]
  coupons         Coupon[]     @relation("CouponCreator")
  couponUsages    CouponUsage[]
  reports         Report[]     @relation("ReportReporter")
  assignedReports Report[]     @relation("ReportAssignee")
  auditLogs       AuditLog[]
  walletTransactions WalletTransaction[]
  escrowAsSeller  EscrowTransaction[] @relation("EscrowSeller")
  escrowAsBuyer   EscrowTransaction[] @relation("EscrowBuyer")
  reviewedListings Listing[] @relation("ListingReviewer")

  @@index([email])
  @@index([status])
  @@index([universityId])
  @@map("users")
}

model Role {
  id          Int       @id @default(autoincrement())
  name        RoleType  @unique
  description String?
  createdAt   DateTime  @default(now())

  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId    Int
  roleId    Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ============================================
// UNIVERSITY & ACADEMICS
// ============================================

model University {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  shortName String?
  address   String?
  website   String?
  logo      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users     User[]
  majors    Major[]

  @@map("universities")
}

model Major {
  id            Int       @id @default(autoincrement())
  name          String
  code          String
  universityId  Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  university    University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  courses       Course[]
  books         Book[]

  @@unique([universityId, code])
  @@map("majors")
}

model Course {
  id        Int       @id @default(autoincrement())
  name      String
  code      String
  majorId   Int
  semester  Int?
  year      Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  major     Major     @relation(fields: [majorId], references: [id], onDelete: Cascade)
  books     Book[]
  listings  Listing[]

  @@unique([majorId, code])
  @@map("courses")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  parentId    Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  books       Book[]

  @@map("categories")
}

// ============================================
// BOOKS & LISTINGS
// ============================================

model Book {
  id              Int          @id @default(autoincrement())
  isbn            String?      @unique
  title           String
  author          String?
  publisher       String?
  edition         String?
  publicationYear  Int?
  description     String?
  coverImage      String?
  condition       BookCondition?
  majorId         Int?
  categoryId      Int?
  courseId        Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  major       Major?     @relation(fields: [majorId], references: [id], onDelete: SetNull)
  category    Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  course      Course?    @relation(fields: [courseId], references: [id], onDelete: SetNull)
  images      BookImage[]
  listings    Listing[]
  favorites   Favorite[]

  @@index([isbn])
  @@index([title])
  @@index([author])
  @@index([publisher])
  @@index([condition])
  @@index([categoryId])
  @@index([majorId])
  @@map("books")
}

model BookImage {
  id        Int      @id @default(autoincrement())
  bookId    Int
  url       String
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@map("book_images")
}

model Listing {
  id          Int           @id @default(autoincrement())
  bookId      Int
  sellerId    Int
  courseId    Int?
  price       Decimal       @db.Decimal(10, 2)
  quantity    Int           @default(1)
  status      ListingStatus @default(DRAFT)
  condition   BookCondition
  description String?
  location    String?
  shippingOption ShippingOption @default(PICKUP)
  rejectionReason String?
  reviewedAt  DateTime?
  reviewerId  Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  publishedAt DateTime?

  book        Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  seller      User          @relation("SellerListings", fields: [sellerId], references: [id], onDelete: Cascade)
  course      Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  reviewer    User?         @relation("ListingReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  images      ListingImage[]
  orderItems  OrderItem[]
  favorites   Favorite[]
  cartItems  CartItem[]

  @@index([bookId])
  @@index([sellerId])
  @@index([status])
  @@index([courseId])
  @@index([price])
  @@map("listings")
}

model ListingImage {
  id        Int      @id @default(autoincrement())
  listingId Int
  url       String
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_images")
}

// ============================================
// CART
// ============================================

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  listingId Int
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing  Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
  @@map("cart_items")
}

// ============================================
// ORDERS & PAYMENTS
// ============================================

model Order {
  id              Int          @id @default(autoincrement())
  orderNumber     String       @unique
  buyerId         Int
  sellerId        Int?
  totalAmount     Decimal      @db.Decimal(10, 2)
  shippingFee     Decimal      @db.Decimal(10, 2) @default(0)
  discountAmount  Decimal      @db.Decimal(10, 2) @default(0)
  finalAmount     Decimal      @db.Decimal(10, 2)
  status          OrderStatus  @default(PENDING_PAYMENT)
  shippingAddress String?
  shippingPhone   String?
  shippingName    String?
  notes           String?
  couponId        Int?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancellationReason String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  buyer           User         @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller          User?        @relation("SellerOrders", fields: [sellerId], references: [id])
  coupon          Coupon?      @relation(fields: [couponId], references: [id], onDelete: SetNull, map: "order_coupon_fk")
  items           OrderItem[]
  payments        Payment[]
  reviews         Review[]
  escrowTransaction EscrowTransaction?

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  listingId   Int
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([orderId, listingId])
  @@index([orderId])
  @@index([listingId])
  @@map("order_items")
}

model Payment {
  id                    Int            @id @default(autoincrement())
  orderId               Int
  method                PaymentMethod
  amount                Decimal        @db.Decimal(10, 2)
  status                PaymentStatus  @default(PENDING)
  transactionId         String?        @unique
  gatewayResponse       Json?
  failureReason         String?
  // VNPAY specific fields
  gatewayTransactionId  String?        // VNPAY transaction number (vnp_TransactionNo)
  gatewayResponseCode   String?        // VNPAY response code (vnp_ResponseCode)
  gatewayResponseMessage String?       // VNPAY response message
  // Banking specific fields
  bankTransferRef       String?        // User enters this to confirm bank transfer
  paidAt                DateTime?
  completedAt           DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  order                 Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([gatewayTransactionId])
  @@index([bankTransferRef])
  @@map("payments")
}

// ============================================
// WALLET & ESCROW
// ============================================

model Wallet {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  balance   Decimal   @db.Decimal(12, 2) @default(0)
  currency  String    @default("VND")
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id          Int             @id @default(autoincrement())
  walletId    Int
  userId      Int
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2)
  balanceBefore Decimal       @db.Decimal(12, 2)
  balanceAfter  Decimal       @db.Decimal(12, 2)
  description String?
  referenceId String?
  referenceType String?
  createdAt   DateTime        @default(now())

  wallet      Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([userId])
  @@index([type])
  @@map("wallet_transactions")
}

model EscrowTransaction {
  id              Int           @id @default(autoincrement())
  orderId         Int?          @unique
  sellerId        Int
  buyerId         Int
  amount          Decimal       @db.Decimal(10, 2)
  platformFee     Decimal       @db.Decimal(10, 2) @default(0)
  status          EscrowStatus  @default(CREATED)
  disputeReason   String?
  resolvedBy      Int?
  resolvedAt      DateTime?
  resolutionNote String?
  createdAt       DateTime      @default(now())
  fundedAt        DateTime?
  heldAt          DateTime?
  releasedAt      DateTime?
  refundedAt      DateTime?
  updatedAt       DateTime      @updatedAt

  order           Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  seller          User          @relation("EscrowSeller", fields: [sellerId], references: [id])
  buyer           User          @relation("EscrowBuyer", fields: [buyerId], references: [id])

  @@index([sellerId])
  @@index([buyerId])
  @@index([status])
  @@map("escrow_transactions")
}

// ============================================
// REVIEWS & RATINGS
// ============================================

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

model Review {
  id          Int         @id @default(autoincrement())
  orderId     Int
  reviewerId  Int
  targetUserId Int
  rating      Int
  comment     String?
  response    String?
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  order       Order    @relation(fields: [orderId], references: [id])
  reviewer    User     @relation("ReviewAuthor", fields: [reviewerId], references: [id])
  targetUser User     @relation("ReviewTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([orderId, reviewerId])
  @@index([targetUserId])
  @@index([rating])
  @@index([status])
  @@map("reviews")
}

// ============================================
// FAVORITES
// ============================================

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  bookId    Int?
  listingId Int?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book?    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@unique([userId, listingId])
  @@index([userId])
  @@index([bookId])
  @@index([listingId])
  @@map("favorites")
}

// ============================================
// COUPONS
// ============================================

model Coupon {
  id            Int       @id @default(autoincrement())
  code          String    @unique
  description   String?
  discountType  DiscountType
  discountValue Decimal   @db.Decimal(10, 2)
  minOrderAmount Decimal? @db.Decimal(10, 2)
  maxDiscountAmount Decimal? @db.Decimal(10, 2)
  usageLimit    Int?
  perUserLimit  Int       @default(1)
  validFrom     DateTime
  validUntil    DateTime
  isActive      Boolean   @default(true)
  createdById   Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  creator       User         @relation("CouponCreator", fields: [createdById], references: [id])
  usages        CouponUsage[]
  orders        Order[]

  @@index([code])
  @@index([validUntil])
  @@map("coupons")
}

model CouponUsage {
  id        Int      @id @default(autoincrement())
  couponId  Int
  userId    Int
  orderId   Int?
  discount  Decimal  @db.Decimal(10, 2)
  usedAt    DateTime @default(now())

  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@index([couponId])
  @@index([userId])
  @@map("coupon_usages")
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id        Int               @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String
  message   String
  data      Json?
  status    NotificationStatus @default(UNREAD)
  readAt    DateTime?
  createdAt DateTime          @default(now())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([type])
  @@map("notifications")
}

// ============================================
// REPORTS
// ============================================

model Report {
  id          Int         @id @default(autoincrement())
  reporterId  Int
  listingId   Int?
  orderId     Int?
  userId      Int?
  type        ReportType
  description String
  evidence    Json?
  status      ReportStatus @default(PENDING)
  resolution  String?
  assigneeId  Int?
  resolvedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  reporter    User    @relation("ReportReporter", fields: [reporterId], references: [id])
  assignee    User?   @relation("ReportAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([status])
  @@index([type])
  @@map("reports")
}

// ============================================
// AUDIT LOGS
// ============================================

model AuditLog {
  id         Int       @id @default(autoincrement())
  userId     Int?
  action     String
  entityType String
  entityId   String?
  oldData    Json?
  newData    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
